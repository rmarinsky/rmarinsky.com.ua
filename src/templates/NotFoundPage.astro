---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../components/Layout.astro";
import { localizedPath, ui, type Locale } from "../content/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].notFound;
---

<Layout locale={locale} title={t.title} description={t.description} robots="noindex, follow">
  <Header locale={locale} />
  <main>
    <section class="hero">
      <div class="container">
        <div class="hero-content">
          <span class="eyebrow">404</span>
          <h1>{t.heading}</h1>
          <p class="lead">{t.lead}</p>
          <a class="button primary" href={localizedPath("/", locale)}>{t.back}</a>
        </div>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</Layout>
