---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../components/Layout.astro";
import { ui, type Locale } from "../content/i18n";
import { site } from "../content/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].about;
---

<Layout locale={locale} title={t.title} description={t.description}>
  <Header locale={locale} />
  <main>
    <section class="about-hero">
      <div class="container">
        <div class="about-hero-inner">
          <div class="about-photo-placeholder" role="img" aria-label={t.heading}></div>
          <span class="eyebrow">{t.eyebrow}</span>
          <h1>{t.heading}</h1>
          <p class="lead">{t.lead}</p>
          <div class="about-links">
            <a href={site.github}>GitHub</a>
            <a href={site.linkedin}>LinkedIn</a>
            <a href={site.npm}>npm</a>
            <a href={site.email}>Email</a>
          </div>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="container">
        <div class="proof-strip">
          {t.proof.map((item) => <strong>{item}</strong>)}
        </div>
      </div>
    </section>

    <section class="band secondary">
      <div class="container">
        <div class="section-header"><h2>{t.workTitle}</h2><p class="body-copy">{t.workBody}</p></div>
        <ol class="career-timeline">
          {t.timeline.map((item) => <li>{item}</li>)}
        </ol>
        <blockquote class="ai-quote">{t.quote}</blockquote>
      </div>
    </section>

    <section class="band">
      <div class="container">
        <div class="section-header"><h2>{t.communityTitle}</h2></div>
        <div class="community-list">
          {t.community.map((item) => (
            <a href={item.url} class="community-item">
              <strong>{item.name}</strong><span>{item.role}</span><span aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="band">
      <div class="container">
        <div class="section-header">
          <span class="kicker">{t.ossKicker}</span>
          <h2>{t.ossTitle}</h2>
        </div>
        <div class="grid three">
          <article class="card tone-appcat">
            <span class="product-icon">A</span>
            <h3>AppCat</h3>
            <p class="body-copy">{t.ossAppCat}</p>
          </article>
          <article class="card tone-diduny">
            <span class="product-icon">D</span>
            <h3>Дідуня</h3>
            <p class="body-copy">{t.ossDiduny}</p>
          </article>
          <article class="card tone-ukraine">
            <span class="product-icon">U</span>
            <h3>ukraine.com.ua MCP</h3>
            <p class="body-copy">{t.ossUkraineMcp}</p>
          </article>
        </div>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</Layout>
