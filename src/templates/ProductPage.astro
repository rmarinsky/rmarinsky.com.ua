---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../components/Layout.astro";
import DiscoveryContextGrid from "../components/DiscoveryContextGrid.astro";
import ProductCard from "../components/ProductCard.astro";
import ProductMockup from "../components/ProductMockup.astro";
import WorkflowMedia from "../components/WorkflowMedia.astro";
import UpdateCard from "../components/UpdateCard.astro";
import { absoluteLocalizedUrl, localizedPath, ui, type Locale } from "../content/i18n";
import { localizedProducts, localizeProduct, productCapabilities, type Product } from "../content/products";
import { site } from "../content/site";
import { getProductUpdates, isUpdateProductSlug } from "../content/updates";

interface Props {
  product: Product;
  locale: Locale;
}

const { locale } = Astro.props;
const product = localizeProduct(Astro.props.product, locale);
const t = ui[locale].product;
const allProducts = localizedProducts(locale);
const productUpdates = isUpdateProductSlug(product.slug) ? getProductUpdates(product.slug) : [];
const relatedProducts = allProducts
  .filter((item) => item.kind === product.kind && item.slug !== product.slug)
  .concat(allProducts.filter((item) => item.kind !== product.kind))
  .slice(0, 3);

const softBackground: Record<Product["accent"], string> = {
  diduny: "color-mix(in srgb, var(--diduny), var(--bg-primary) 88%)",
  appcat: "color-mix(in srgb, var(--appcat), var(--bg-primary) 88%)",
  papuga: "color-mix(in srgb, var(--papuga), var(--bg-primary) 88%)",
  sidebarny: "color-mix(in srgb, var(--sidebarny), var(--bg-primary) 88%)",
  wayforpay: "color-mix(in srgb, var(--wayforpay), var(--bg-primary) 88%)",
  ukraine: "color-mix(in srgb, var(--ukraine), var(--bg-primary) 88%)",
};

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": `${site.url}/${product.slug}/#software`,
  name: product.latinName,
  alternateName: [...new Set([product.name, product.latinName])],
  description: product.seoDescription,
  abstract: product.discoveryAnswer,
  url: absoluteLocalizedUrl(`/${product.slug}/`, locale),
  inLanguage: locale === "uk" ? "uk-UA" : "en",
  image: new URL(product.image.src, site.url).toString(),
  installUrl: product.kind === "mac" ? product.primaryUrl : undefined,
  applicationCategory:
    product.kind === "mac" ? "UtilitiesApplication" : product.kind === "extension" ? "BrowserApplication" : "DeveloperApplication",
  operatingSystem: product.kind === "mac" ? "macOS" : product.kind === "extension" ? "Chrome" : "Cross-platform",
  featureList: productCapabilities(product),
  keywords: [...product.discoveryQueries, ...product.discoveryContext.aliases, ...product.discoveryContext.useCases],
  audience: product.discoveryContext.audiences.map((audienceType) => ({ "@type": "Audience", audienceType })),
  author: { "@id": `${site.url}/#person` },
  isPartOf: { "@id": `${site.url}/#website` },
  sameAs: product.secondaryUrl ? [product.primaryUrl, product.secondaryUrl] : [product.primaryUrl],
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: t.breadcrumbs,
      item: absoluteLocalizedUrl("/", locale),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: product.name,
      item: absoluteLocalizedUrl(`/${product.slug}/`, locale),
    },
  ],
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: product.faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<Layout
  locale={locale}
  title={product.seoTitle}
  description={product.seoDescription}
  image={product.image.src}
  applicationName={product.latinName}
  jsonLd={[productJsonLd, breadcrumbJsonLd, faqJsonLd]}
>
  <Header locale={locale} />
  <main>
    <section class={`product-hero tone-${product.accent}`} style={`--product-soft: ${softBackground[product.accent]};`}>
      <div class="container product-hero-inner">
        <div class="product-copy">
          <div class="breadcrumbs"><a href={localizedPath("/", locale)}>{t.breadcrumbs}</a> / {product.name}</div>
          <span class="product-icon">{product.letter}</span>
          <h1>{product.title}</h1>
          <p class="lead">{product.summary}</p>
          <div class="pill-row">
            {product.badges.map((badge) => <span class="pill">{badge}</span>)}
          </div>
          <div class="button-row">
            <a class="button primary" href={product.primaryUrl}>{product.primaryCta}</a>
            {product.secondaryUrl && product.secondaryCta && <a class="button" href={product.secondaryUrl}>{product.secondaryCta}</a>}
          </div>
        </div>
        <ProductMockup product={product} />
      </div>
    </section>

    <section class="band">
      <div class="container">
        <div class={`trust-panel tone-${product.accent}`}>
          <span class="kicker">{t.stanceKicker}</span>
          <h2>{product.privacyTitle}</h2>
          <p class="body-copy">{product.privacyBody}</p>
        </div>
      </div>
    </section>

    {product.workflows ? (
      <section class="band secondary">
        <div class="container">
          <div class="section-header">
            <span class="kicker">{t.workflowsKicker}</span>
            <h2>{t.workflowsTitle}</h2>
          </div>
          <div class="workflow-list">
            {product.workflows.map((workflow, index) => (
              <article class={`workflow-row tone-${product.accent}`}>
                <div class="workflow-copy">
                  <h3>{workflow.title}</h3>
                  <p class="body-copy"><strong>{t.problemLabel}</strong> {workflow.problem}</p>
                  <p class="body-copy"><strong>{t.outcomeLabel}</strong> {workflow.outcome}</p>
                  <ol class="workflow-steps">
                    {workflow.steps.map((step) => <li>{step}</li>)}
                  </ol>
                </div>
                <WorkflowMedia workflow={workflow} eager={index === 0} />
              </article>
            ))}
          </div>
        </div>
      </section>
    ) : (
      <section class="band secondary">
      <div class="container">
        <div class="section-header">
          <span class="kicker">{t.featuresKicker}</span>
          <h2>{t.featuresTitle}</h2>
        </div>
        <div class="feature-grid">
          {product.features.map((feature) => (
            <article class={`card feature-card tone-${product.accent}`}>
              {feature.tone && <span class="status-badge">{feature.tone}</span>}
              <h3>{feature.title}</h3>
              <p class="body-copy">{feature.body}</p>
            </article>
          ))}
        </div>
      </div>
      </section>
    )}

    <section class="band">
      <div class="container">
        <div class="section-header">
          <span class="kicker">{t.discoveryKicker}</span>
          <h2>{t.discoveryTitle}</h2>
          <p class="body-copy">{product.discoveryAnswer}</p>
        </div>
        <ul class="discovery-query-list">
          {product.discoveryQueries.slice(0, 6).map((query) => <li>“{query}”</li>)}
        </ul>
        <p class="body-copy"><strong>{t.pricingLabel}</strong> {product.pricingNote}</p>
        <a class="button compact" href={localizedPath(`/discover/#${product.slug}`, locale)}>{t.allDiscovery}</a>
      </div>
    </section>

    <section class="band secondary">
      <div class="container">
        <div class="section-header">
          <span class="kicker">{t.contextKicker}</span>
          <h2>{t.contextTitle}</h2>
          <p class="body-copy">{product.discoveryAnswer}</p>
        </div>
        <DiscoveryContextGrid
          context={product.discoveryContext}
          labels={{
            audience: t.audienceTitle,
            useCases: t.useCasesTitle,
            inputs: t.inputTitle,
            outputs: t.outputTitle,
            constraints: t.constraintsTitle,
            notFor: t.notForTitle,
          }}
        />
      </div>
    </section>

    {(product.proof || product.limitations) && (
      <section class="band">
        <div class="container product-facts">
          {product.proof && (
            <div>
              <span class="kicker">{t.proofKicker}</span>
              <ul class="proof-list">{product.proof.map((item) => <li>{item}</li>)}</ul>
            </div>
          )}
          {product.limitations && (
            <div class="limitations">
              <span class="kicker">{t.boundariesKicker}</span>
              {product.limitations.map((item) => <p class="body-copy">{item}</p>)}
            </div>
          )}
        </div>
      </section>
    )}

    {product.installCommand && (
      <section class="band" id="install">
        <div class="container">
          <div class="install-panel">
            <span class="kicker">{t.installKicker}</span>
            <h2>{t.installTitle}</h2>
            <pre class="code-block"><code>{product.installCommand}</code></pre>
            <p class="body-copy">{t.installBody}</p>
          </div>
        </div>
      </section>
    )}

    <section class="band">
      <div class="container">
        <div class="section-header">
          <span class="kicker">{t.faqKicker}</span>
          <h2>{t.faqTitle}</h2>
        </div>
        <div class="faq-list">
          {product.faq.map((item) => (
            <article class="faq-item">
              <h3>{item.question}</h3>
              <p class="body-copy">{item.answer}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    {productUpdates.length > 0 && (
      <section class="band secondary">
        <div class="container">
          <div class="section-header split-header">
            <div>
              <span class="kicker">{t.updatesKicker}</span>
              <h2>{t.updatesTitle} {product.name}</h2>
            </div>
            <a class="button compact" href={localizedPath("/updates/", locale)}>{t.allUpdates}</a>
          </div>
          <div class="updates-grid">
            {productUpdates.map((update) => <UpdateCard update={update} locale={locale} />)}
          </div>
        </div>
      </section>
    )}

    <section class="band secondary">
      <div class="container">
        <div class="section-header">
          <span class="kicker">{t.moreKicker}</span>
          <h2>{t.moreTitle}</h2>
        </div>
        <div class="grid three">
          {relatedProducts.map((item) => <ProductCard product={item} locale={locale} />)}
        </div>
      </div>
    </section>

    <section class="band final-cta">
      <div class="container final-cta-inner">
        <h2>{product.finalCta}</h2>
        <div class="button-row">
          <a class="button primary" href={product.primaryUrl}>{product.primaryCta}</a>
          <a class="button" href={localizedPath("/", locale)}>{t.back}</a>
        </div>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</Layout>
