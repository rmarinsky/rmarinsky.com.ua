---
import { didunyBillingCopy } from "../content/diduny-billing";
import { localizedPath, type Locale } from "../content/i18n";
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = didunyBillingCopy[locale];
const uk = locale === "uk";
const free = [t.localNoLimit, t.localDictateItem, t.localMeetingItem, t.localImportItem, t.localTranslationItem, t.formatItem, t.freeCloudItem];
const rows = [[t.dictation,t.localDictation,t.cloudDictation],[t.meetings,t.localMeeting,t.cloudMeeting],[t.voice,t.localTranslate,t.cloudTranslate],[t.meetingTranslate,t.localMeetingTranslate,t.cloudMeetingTranslate],[t.imports,t.localImports,t.cloudImports]];
const planRows = [[t.allLocal,t.unlimited,t.unlimited,t.unlimited],[t.cloudAllowance,t.twoHours,t.twoHours,t.noQuota],[t.style,t.included,t.included,t.included],[t.communityAccess,"—",t.invitationPending,t.invitationPending],[t.ideasAccess,"—",t.included,t.included]];
---
<section class="band secondary" id="plans" data-diduny-paywall data-locale={locale}>
  <div class="container">
    <div data-stage="benefits">
      <h2 tabindex="-1">{t.title}</h2><p class="lead">{t.lead}</p>
      <div class="local"><strong>{t.local}</strong><p>{t.localNote}</p></div>
      <div class="benefits">{[1, 2, 3].map((n) => <article><h3>{t[`benefit${n}` as "benefit1"]}</h3><p>{t[`benefit${n}Body` as "benefit1Body"]}</p></article>)}</div>
      <button class="button primary" data-next="plans">{uk ? "Порівняти Free, Підтримку та Pro" : "Compare Free, Support and Pro"}</button>
    </div>
    <div data-stage="plans" hidden>
      <button class="back" data-next="benefits">← {t.backBenefits}</button>
      <h2 tabindex="-1">{t.plansTitle}</h2>
      <div class="period" role="group" aria-label={t.period}>
        <button data-period="monthly" aria-pressed="true">{t.monthly}</button>
        <button data-period="yearly" aria-pressed="false">{t.annual}</button>
        <button data-lifetime>{t.lifetime}</button>
      </div>
      <p>{t.periodNote}</p>
      <div class="table-scroll plan-table" data-plan-comparison tabindex="0" role="region" aria-label={t.table}>
        <table><thead><tr><th scope="col">{t.feature}</th><th scope="col">{t.free}<strong class="price">₴0</strong><small>{t.forever}</small></th><th scope="col">{t.support}<strong class="price">₴69</strong><small>{t.perMonth}</small></th><th scope="col">{t.pro}<strong class="price" data-pro-price>₴150</strong><small data-pro-period>{t.perMonth}</small></th></tr></thead>
          <tbody>
            {free.slice(0,-2).map(item => <tr><th scope="row">{item}</th><td>{t.included}</td><td>{t.included}</td><td>{t.included}</td></tr>)}
            {[t.cloudDictationTitle,t.cloudMeetingsTitle,t.cloudVoiceTitle,t.cloudMeetingTitle].map(item => <tr><th scope="row">{item}</th><td>{t.withinCloud}</td><td>{t.withinCloud}</td><td>{t.included}</td></tr>)}
            {planRows.slice(1).map(row => <tr><th scope="row">{row[0]}</th>{row.slice(1).map(value => <td>{value}</td>)}</tr>)}
            <tr><th scope="row">{uk ? "Обрати план" : "Choose a plan"}</th>
              <td><a class="button" href="https://github.com/rmarinsky/Diduny/releases/latest">{uk ? "Безкоштовно" : "Use Free"}</a></td>
              <td><button class="button" data-product="support">{uk ? "Обрати Підтримку" : "Choose Support"}</button></td>
              <td><button class="button primary" data-product="pro">{uk ? "Обрати Pro" : "Choose Pro"}</button></td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="note">{t.freeNote}</p>
      <p class="note">{uk ? "Запрошення до спільноти готується. Нові функції можна пропонувати й обговорювати; строків реалізації не гарантуємо." : "The community invitation is being prepared. Members can suggest and discuss new features; delivery dates are not guaranteed."}</p>
      <details data-local-cloud-comparison><summary>{t.models}</summary><div class="table-scroll" tabindex="0" role="region" aria-label={t.models}><table><thead><tr><th scope="col">{t.feature}</th><th scope="col">{t.localColumn}</th><th scope="col">{t.cloudColumn}</th></tr></thead><tbody>{rows.map(row => <tr><th scope="row">{row[0]}</th><td>{row[1]}</td><td>{row[2]}</td></tr>)}</tbody></table></div><p>{t.modelNote}</p><p>{t.cleanNote}</p></details>

      <details><summary>{t.oneTime}</summary><p>{t.oneTimeBody}</p><button class="button" data-product="one_time">{uk ? "Перевірити разовий рік" : "Review one-time annual"}</button></details>
    </div>
    <div data-stage="review" hidden>
      <button class="back" data-next="plans">← {t.back}</button><h2 tabindex="-1">{t.reviewTitle}</h2>
      <dl><div><dt>{uk ? "План" : "Plan"}</dt><dd data-review-plan></dd></div><div><dt>{t.period}</dt><dd data-review-period></dd></div><div><dt>{t.total}</dt><dd data-review-total></dd></div></dl>
      <p data-review-terms></p>
      <p>{uk ? "Відкрий вибраний план у Дідуні. Після входу застосунок перевірить ціну на сервері та покаже підтвердження перед захищеною оплатою WayForPay." : "Open your selected plan in Diduny. After sign-in, the app checks the server price and shows a review before secure WayForPay checkout."}</p>
      <a class="button primary" data-open-diduny href="diduny://billing?product=pro&amp;interval=monthly">{uk ? "Відкрити цей план у Дідуні" : "Open this plan in Diduny"}</a>
      <p><a href="https://github.com/rmarinsky/Diduny/releases/latest">{uk ? "Ще немає застосунку? Завантажити Дідуню" : "Need the app? Download Diduny"}</a></p>
    </div>
    <p class="note"><a href={localizedPath("/legal/#diduny-offer", locale)}>{t.policy}</a></p>
    <dialog aria-labelledby="diduny-lifetime-title"><h3 id="diduny-lifetime-title">{t.lifetimeTitle}</h3><p>{t.lifetimeBody}</p><button class="button" data-close>{t.done}</button></dialog>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>("[data-diduny-paywall]").forEach(root => {
    const uk = root.dataset.locale === "uk";
    let yearly = false;
    const show = (name: string) => {
      root.querySelectorAll<HTMLElement>("[data-stage]").forEach(section => { section.hidden = section.dataset.stage !== name; });
      const heading = root.querySelector<HTMLElement>(`[data-stage="${name}"] h2`);
      heading?.focus({ preventScroll: true }); root.scrollIntoView({ behavior: "instant", block: "start" });
    };
    root.querySelectorAll<HTMLButtonElement>("[data-next]").forEach(button => button.addEventListener("click", () => show(button.dataset.next!)));
    root.querySelectorAll<HTMLButtonElement>("[data-period]").forEach(button => button.addEventListener("click", () => {
      yearly = button.dataset.period === "yearly";
      root.querySelectorAll("[data-period]").forEach(item => item.setAttribute("aria-pressed", String(item === button)));
      root.querySelector("[data-pro-price]")!.textContent = yearly ? "₴1500" : "₴150";
      root.querySelector("[data-pro-period]")!.textContent = uk ? yearly ? "/ рік" : "/ місяць" : yearly ? "/ year" : "/ month";
    }));
    root.querySelectorAll<HTMLButtonElement>("[data-product]").forEach(button => button.addEventListener("click", () => {
      const support = button.dataset.product === "support", once = button.dataset.product === "one_time";
      const annual = !support && (yearly || once);
      root.querySelector("[data-review-plan]")!.textContent = support ? uk ? "Підтримка" : "Support" : "Diduny Pro";
      root.querySelector("[data-review-period]")!.textContent = annual ? uk ? "12 місяців" : "12 months" : uk ? "1 місяць" : "1 month";
      root.querySelector("[data-review-total]")!.textContent = support ? "₴69" : annual ? "₴1500" : "₴150";
      root.querySelector("[data-review-terms]")!.textContent = once
        ? uk ? "Разова оплата. Без автопоновлення." : "One-time payment. No automatic renewal."
        : uk ? `Автопоновлення ${annual ? "щороку" : "щомісяця"}. Скасування зупиняє наступне списання; доступ діє до кінця оплаченого періоду.` : `Renews ${annual ? "yearly" : "monthly"}. Cancellation stops the next payment; access lasts until the paid period ends.`;
      root.querySelector<HTMLAnchorElement>("[data-open-diduny]")!.href = `diduny://billing?product=${support ? "support" : "pro"}&interval=${annual ? "yearly" : "monthly"}&mode=${once ? "one_time" : "recurring"}`;
      show("review");
    }));
    const dialog = root.querySelector("dialog")!;
    root.querySelector("[data-lifetime]")!.addEventListener("click", () => dialog.showModal());
    root.querySelector("[data-close]")!.addEventListener("click", () => dialog.close());
  });
</script>
<style>
  section { scroll-margin-top: 112px; } [hidden] { display: none !important; }
  h2 { max-width: 900px; } h3 { font-size: 1.35rem; } p { color: var(--text-secondary); line-height: 1.6; }
  .local { margin: 24px 0; padding: 20px; background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 10px; }
  .benefits,.offers { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 20px; margin: 28px 0; }
  .benefits article { border-left: 2px solid var(--diduny); padding-left: 20px; }
  .offers article { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 12px; padding: 26px; background: var(--bg-elevated); }
  .offers .pro { border-color: var(--diduny); background: color-mix(in srgb,var(--diduny),var(--bg-primary) 93%); }
  .price { display: block; font-size: 2.5rem; letter-spacing: -.04em; margin: 16px 0 0; }
  ul { padding-left: 20px; line-height: 1.65; margin: 22px 0; } li { margin-bottom: 12px; } li::marker { color: var(--diduny); }
  .offers .button { margin-top: auto; } h4 { margin-top: 16px; padding-top: 20px; border-top: 1px solid var(--border); }
  .period { display: inline-flex; flex-wrap: wrap; gap: 4px; border: 1px solid var(--border); border-radius: 10px; padding: 5px; }
  .period button,.back { font: inherit; color: var(--text-primary); cursor: pointer; background: transparent; border: 0; padding: 10px 15px; border-radius: 7px; }
  .period [aria-pressed="true"] { background: var(--bg-primary); box-shadow: 0 1px 5px #0002; }
  .back { padding-left: 0; margin-bottom: 20px; } .note { font-size: .9rem; max-width: 950px; }
  .table-scroll { overflow-x: auto; } .plan-table table { min-width: 640px; table-layout: fixed; } .plan-table th:first-child { width: 30%; } .plan-table th:not(:first-child) { width: 23.33%; } .plan-table small { display: block; font-weight: 400; margin-top: 8px; } .plan-table .button { padding: 12px; font-size: .9rem; } .plan-table th:last-child, .plan-table td:last-child { background: #335ca630; border-left: 1px solid #5078cc66; border-right: 1px solid #5078cc66; } .plan-table thead th:last-child { border-top: 1px solid #5078cc66; } .plan-table tfoot td:last-child { border-bottom: 1px solid #5078cc66; } table { border-collapse: collapse; width: 100%; min-width: 620px; margin: 20px 0; } th,td { text-align: left; padding: 14px; border-bottom: 1px solid var(--border); line-height: 1.5; } thead { background: var(--bg-elevated); }
  details { margin: 24px 0; } summary { cursor: pointer; } dl { max-width: 680px; margin: 30px 0; } dl div { display: flex; justify-content: space-between; gap: 20px; padding: 15px 0; border-bottom: 1px solid var(--border); } dd { font-weight: 650; }
  dialog { color: var(--text-primary); background: var(--bg-primary); border: 1px solid var(--border); border-radius: 12px; max-width: 550px; padding: 30px; } dialog::backdrop { background: #0006; }
  button:focus-visible,a:focus-visible { outline: 3px solid var(--diduny); outline-offset: 4px; }
  @media(max-width: 850px) { .benefits,.offers { grid-template-columns: 1fr; } .offers article { padding: 22px; } }
</style>
