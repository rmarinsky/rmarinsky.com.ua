---
import { localizedPath, ui, type Locale } from "../content/i18n";
import { site } from "../content/site";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? "uk";
const t = ui[locale].nav;
const currentPath = Astro.url.pathname;
---

<header class="page-header">
  <div class="container">
    <nav class="nav" aria-label="Primary navigation">
      <a class="brand" href={localizedPath("/", locale)}>{site.name}</a>
      <div class="nav-right">
        <div class="nav-links">
          <a href={localizedPath("/discover/", locale)}>{t.discover}</a>
          <a href={localizedPath("/#mac-apps", locale)}>{t.macApps}</a>
          <a href={localizedPath("/#extension", locale)}>{t.extension}</a>
          <a href={localizedPath("/#mcp", locale)}>{t.mcp}</a>
          <a href={localizedPath("/updates/", locale)}>{t.updates}</a>
          <a href={localizedPath("/about/", locale)}>{t.about}</a>
        </div>
        <span class="language-toggle" aria-label="Language selector">
          <a class={locale === "uk" ? "active" : ""} href={localizedPath(currentPath, "uk")} lang="uk" hreflang="uk-UA" aria-current={locale === "uk" ? "true" : undefined}>UA</a>
          <span>/</span>
          <a class={locale === "en" ? "active" : ""} href={localizedPath(currentPath, "en")} lang="en" hreflang="en" aria-current={locale === "en" ? "true" : undefined}>EN</a>
        </span>
        <details class="mobile-menu">
          <summary aria-label={t.open}>
            <span class="mobile-menu-mark" aria-hidden="true"><span></span></span>
          </summary>
          <div class="mobile-menu-panel">
            <a href={localizedPath("/discover/", locale)}>{t.discover}</a>
            <a href={localizedPath("/#mac-apps", locale)}>{t.macApps}</a>
            <a href={localizedPath("/#extension", locale)}>{t.extension}</a>
            <a href={localizedPath("/#mcp", locale)}>{t.mcp}</a>
            <a href={localizedPath("/updates/", locale)}>{t.updates}</a>
            <a href={localizedPath("/about/", locale)}>{t.about}</a>
          </div>
        </details>
      </div>
    </nav>
  </div>
</header>
