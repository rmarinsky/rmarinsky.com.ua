---
import { localizedPath, type Locale } from "../content/i18n";
import type { Product } from "../content/products";

interface Props {
  product: Product;
  locale?: Locale;
}

const { product } = Astro.props;
const locale = Astro.props.locale ?? "uk";
const displayName = product.name === product.latinName ? product.name : `${product.name} · ${product.latinName}`;
---

<a class={`card product-card tone-${product.accent}`} href={localizedPath(`/${product.slug}/`, locale)}>
  <span class={`product-card-media visual-${product.image.variant}`}>
    <img src={product.image.src} alt={product.image.alt} loading="eager" decoding="async" />
  </span>
  <span class="product-icon">{product.letter}</span>
  <h3>{displayName}</h3>
  <p class="body-copy">{product.homepageSummary}</p>
  <span class="tone-text" aria-label={product.primaryCta}>{product.primaryCta} -></span>
</a>
